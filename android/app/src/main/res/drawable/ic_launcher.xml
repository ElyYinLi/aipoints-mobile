<?xml version="1.0" encoding="utf-8"?>
<!-- App 图标：由 core/panel/icons.go 的 appIcon 转写为 Android VectorDrawable。
     0.6.8：白色 spark 双星，与面板左上角 logo / iOS 图标同源，坐标三端共用。
     用矢量而非 PNG：一个文件适配所有密度，APK 体积不变大。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!-- 渐变底（用 layer-list 无法直接给 vector 上渐变，这里用两段近似色堆叠） -->
    <path android:pathData="M232,0 L792,0 A232,232 0 0 1 1024,232 L1024,792 A232,232 0 0 1 792,1024 L232,1024 A232,232 0 0 1 0,792 L0,232 A232,232 0 0 1 232,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="1024" android:endY="1024">
                <item android:offset="0" android:color="#FF4F6BFF" />
                <item android:offset="0.55" android:color="#FF7B4DFF" />
                <item android:offset="1" android:color="#FFC24DFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 主星：居中偏上 -->
    <path android:fillColor="#00000000" android:strokeColor="#FFFFFFFF"
        android:strokeWidth="48" android:strokeLineCap="round" android:strokeLineJoin="round"
        android:pathData="M474.5,234.5 L531.5,387.5 L684.5,444.5 L531.5,501.5 L474.5,654.5 L417.5,501.5 L264.5,444.5 L417.5,387.5 Z" />
    <!-- 副星：右下角 -->
    <path android:fillColor="#00000000" android:strokeColor="#FFFFFFFF"
        android:strokeWidth="46" android:strokeLineCap="round" android:strokeLineJoin="round"
        android:pathData="M669.5,609.5 L693.5,675.5 L759.5,699.5 L693.5,723.5 L669.5,789.5 L645.5,723.5 L579.5,699.5 L645.5,675.5 Z" />
</vector>
