<?xml version="1.0" encoding="utf-8"?>
<!-- App 图标：由 core/panel/icons.go 的 appIcon 转写为 Android VectorDrawable。
     0.6.9 V4 错位呼应：白色空心 spark 双星，小星描边减细到 28（空心清晰），与面板 logo / iOS 图标同源，坐标三端共用。
     用矢量而非 PNG：一个文件适配所有密度，APK 体积不变大。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!-- 渐变底（用 layer-list 无法直接给 vector 上渐变，这里用两段近似色堆叠） -->
    <!-- 0.7.0：改满幅方形，与 iOS 侧去掉预烘焙圆角保持一致（Android 由 adaptive icon 裁切） -->
    <path android:pathData="M0,0 L1024,0 L1024,1024 L0,1024 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="1024" android:endY="1024">
                <item android:offset="0" android:color="#FF4F6BFF" />
                <item android:offset="0.55" android:color="#FF7B4DFF" />
                <item android:offset="1" android:color="#FFC24DFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 主星：居中偏上 -->
    <path android:fillColor="#00000000" android:strokeColor="#FFFFFFFF"
        android:strokeWidth="48" android:strokeLineCap="round" android:strokeLineJoin="round"
        android:pathData="M455,195 L514.1,355.9 L675,415 L514.1,474.1 L455,635 L395.9,474.1 L235,415 L395.9,355.9 Z" />
    <!-- 副星：右下角，放大到 112 半径、描边减细到 28，空心清晰 -->
    <path android:fillColor="#00000000" android:strokeColor="#FFFFFFFF"
        android:strokeWidth="28" android:strokeLineCap="round" android:strokeLineJoin="round"
        android:pathData="M710,623 L740.1,704.9 L822,735 L740.1,765.1 L710,847 L679.9,765.1 L598,735 L679.9,704.9 Z" />
</vector>
