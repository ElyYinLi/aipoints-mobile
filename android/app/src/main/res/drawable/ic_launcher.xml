<?xml version="1.0" encoding="utf-8"?>
<!-- App 图标：由 core/panel/icons.go 的 appIcon 转写为 Android VectorDrawable。
     三层积分卡 + 签到勾，与面板内 logo 同源。
     用矢量而非 PNG：一个文件适配所有密度，APK 体积不变大。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!-- 渐变底（用 layer-list 无法直接给 vector 上渐变，这里用两段近似色堆叠） -->
    <path android:pathData="M232,0 L792,0 A232,232 0 0 1 1024,232 L1024,792 A232,232 0 0 1 792,1024 L232,1024 A232,232 0 0 1 0,792 L0,232 A232,232 0 0 1 232,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="1024" android:endY="1024">
                <item android:offset="0" android:color="#FF4F6BFF" />
                <item android:offset="0.55" android:color="#FF7B4DFF" />
                <item android:offset="1" android:color="#FFC24DFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 第三层（最窄，底部） -->
    <path android:fillColor="#66FFFFFF"
        android:pathData="M351,676 L673,676 A59,59 0 0 1 673,794 L351,794 A59,59 0 0 1 351,676 Z" />
    <!-- 第二层 -->
    <path android:fillColor="#96FFFFFF"
        android:pathData="M323,512 L701,512 A59,59 0 0 1 701,630 L323,630 A59,59 0 0 1 323,512 Z" />
    <!-- 第一层（最宽，顶部，最亮） -->
    <path android:fillColor="#F5FFFFFF"
        android:pathData="M295,348 L729,348 A59,59 0 0 1 729,466 L295,466 A59,59 0 0 1 295,348 Z" />

    <!-- 签到勾 -->
    <path android:fillColor="#00000000" android:strokeColor="#FF22D48A"
        android:strokeWidth="58" android:strokeLineCap="round" android:strokeLineJoin="round"
        android:pathData="M596,246 L648,298 L752,180" />
</vector>
